# Copie este arquivo para .env e preencha os valores.
# O .env é lido pelo Spring Boot (spring.config.import) e pelo Docker Compose.

DB_URL=jdbc:postgresql://localhost:5434/restaurant_db
DB_NAME=restaurant_db
DB_USERNAME=restaurant_user
DB_PASSWORD=troque-esta-senha

# Chave em Base64 com no mínimo 256 bits. Para gerar uma:
# openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=86400000

# Admin criado automaticamente na primeira inicialização (se ainda não existir).
ADMIN_EMAIL=admin@restaurant.com
ADMIN_PASSWORD=troque-esta-senha

# Mostra no log o SQL gerado pelo Hibernate (útil para depurar, como no caso do N+1).
SHOW_SQL=false
